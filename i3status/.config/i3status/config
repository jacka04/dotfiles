# i3status configuration file.
# see "man i3status" for documentation.

general {
    colors = true
    interval = 2
    color_good = "#a6e3a1"      # Verde suave (estado normal)
    color_degraded = "#f9e2af"  # Amarillo pastel (alerta baja)
    color_bad = "#f38ba8"       # Rojo suave (alerta crítica)
}

order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "volume master"
order += "tztime local"

ethernet _first_ {
    format_up = "LAN: %ip"
    format_down = "LAN: down"
}

disk "/" {
    format = "DISC: %avail libre"
    prefix_type = custom
    low_threshold = 10
    threshold_type = gbytes_avail
}

memory {
    format = "RAM: %used"
    threshold_degraded = "10%"
    threshold_critical = "5%"
    format_degraded = "RAM BAJA: %free"
}

volume master {
    format = "VOL: %volume"
    format_muted = "VOL: silenciado"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = "%d/%m/%Y  %H:%M"
}
